# Copy this file to .env and fill in your own key.
# Get a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model used for translations. "flash-lite" has
# its own, more usable free-tier daily quota than the full "flash" model (which
# is capped very low - 20 requests/day on this project - and shared across
# every feature that calls it). The "-latest" alias avoids pinning to a dated
# model that later loses free-tier quota or gets retired.
# Check https://ai.google.dev/gemini-api/docs/models for the current list.
GEMINI_MODEL=gemini-flash-lite-latest
