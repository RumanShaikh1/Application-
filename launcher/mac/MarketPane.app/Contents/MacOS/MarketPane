#!/bin/bash
# MarketPane launcher (macOS) - a genuinely zero-prerequisite app: a portable
# Node.js runtime (both Apple Silicon and Intel builds), the bundled server,
# the built web app, and its data fixtures all ship inside this .app bundle's
# own Contents/Resources/ - no Node.js install, no npm install, no separate
# repo checkout needed on the machine this runs on. First run just links a
# browser (there is no Xcode-free way to embed a real native webview - see
# open_browser below), then every run starts the embedded server and opens
# the linked browser to it in app mode. Every failure shows a real dialog -
# nothing fails silently, same principle as the Windows original's
# Show-ErrorBox.
#
# The Jargon Buster browser extension is a separate concern, deliberately
# not handled by this launcher (matches the Windows MarketPane.Desktop.exe
# split: MarketPane.bat/MarketPane.ps1 remains the path that builds and
# loads the extension, still needs Node.js for that one piece - this .app
# is the zero-dependency alternative for Decision Replay/Simulator/Tax
# Understanding/Sandbox/Learn only, same as its Windows counterpart).
#
# NOTE ON VERIFICATION: authored and syntax-checked (bash -n) on a non-Mac
# machine - there is no Mac available to actually run the double-click /
# AppleScript-dialog / browser-launch flow end to end. Treat this as a
# best-effort, carefully-reasoned port, not a verified-working build. See
# README.md's "Running on macOS" section, and please report back what (if
# anything) needs fixing after a real run.
#
# AppleScript dialogs are generated into temp files and run via
# `osascript <file>` rather than `osascript -e "..."` - inline -e strings
# need bash and AppleScript quoting to nest correctly at the same time,
# which is fragile; a heredoc-written temp file lets bash variables
# interpolate as plain text with no nested-quote escaping at all.
#
# Message strings are always built with `printf -v` (never plain "...\n..."
# double-quoted literals) - bash does not interpret \n inside a normal
# double-quoted string, so a literal "\n" would show up as two visible
# characters in the dialog instead of a line break. printf does interpret
# it, and %s handles variable interpolation at the same time.

set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Everything the app needs lives inside its own bundle now - no more
# walking up to find a sibling repo checkout (that assumption broke the
# moment this .app needed to be a standalone download in its own right,
# same reasoning as MainForm.cs dropping FindRepoRoot() on Windows).
RESOURCES_DIR="$(cd "$SCRIPT_DIR/../Resources" && pwd)"
SERVER_SCRIPT="$RESOURCES_DIR/server.mjs"
WEB_DIST_DIR="$RESOURCES_DIR/web-dist"
SERVER_DATA_DIR="$RESOURCES_DIR/data"
SERVER_ENV_EXAMPLE_PATH="$RESOURCES_DIR/.env.example"
PORT=8787
HEALTH_URL="http://localhost:$PORT/health"
SIMULATOR_URL="http://localhost:$PORT/simulator"

# ~/Library/Application Support is the standard per-user config location on
# macOS - the direct analogue of the Windows launcher's %LOCALAPPDATA%\MarketPane.
# Used for the one thing that must be writable and must survive an app
# update (the user's own .env with their Gemini key) plus logs and the
# linked-browser config - never for the read-only bundled runtime itself,
# which lives inside Resources/ above and is never written to.
CONFIG_DIR="$HOME/Library/Application Support/MarketPane"
CONFIG_PATH="$CONFIG_DIR/config.sh"
LOG_DIR="$CONFIG_DIR/logs"
SERVER_LOG="$LOG_DIR/server.log"
SERVER_ENV_PATH="$CONFIG_DIR/.env"

mkdir -p "$LOG_DIR"

run_applescript_file() {
  osascript "$1" 2>/dev/null
}

show_error() {
  local message="$1"
  local script
  script="$(mktemp /tmp/marketpane-dialog.XXXXXX.applescript)"
  cat >"$script" <<EOF
display dialog "$message" with title "MarketPane" buttons {"OK"} default button "OK" with icon stop
EOF
  run_applescript_file "$script" >/dev/null
  rm -f "$script"
}

show_info() {
  local message="$1"
  local script
  script="$(mktemp /tmp/marketpane-dialog.XXXXXX.applescript)"
  cat >"$script" <<EOF
display dialog "$message" with title "MarketPane" buttons {"OK"} default button "OK"
EOF
  run_applescript_file "$script" >/dev/null
  rm -f "$script"
}

# --- embedded Node runtime ---------------------------------------------

# Picks the node binary matching this Mac's own CPU architecture - both
# Apple Silicon (arm64) and Intel (x86_64) builds ship inside the bundle
# since there is no way to know which one a given download will run on.
# `uname -m` is the standard, always-available way to ask macOS which
# architecture it's actually running as (not which one the *app* was built
# for - relevant on Apple Silicon Macs running under Rosetta, where this
# still correctly resolves to the real arm64 hardware).
resolve_node_binary() {
  local arch
  arch="$(uname -m)"
  if [ "$arch" = "arm64" ]; then
    printf '%s' "$RESOURCES_DIR/node-darwin-arm64"
  else
    printf '%s' "$RESOURCES_DIR/node-darwin-x64"
  fi
}

# Copies .env.example -> .env (in the writable config dir, not the
# read-only bundle) the first time only - never overwrites a real,
# already-configured .env. The server starts fine on the placeholder key
# (see server/src/gemini.ts): only the Gemini-powered features need a real
# one, added later at the user's own pace.
ensure_server_env_file() {
  if [ -f "$SERVER_ENV_EXAMPLE_PATH" ] && [ ! -f "$SERVER_ENV_PATH" ]; then
    cp "$SERVER_ENV_EXAMPLE_PATH" "$SERVER_ENV_PATH"
  fi
}

is_server_healthy() {
  local response
  response="$(curl -fsS -m 2 "$HEALTH_URL" 2>/dev/null)"
  [[ "$response" == *'"ok":true'* ]]
}

# Same shape as the Windows launcher's EnsureServerRunningAsync: already-
# running check, background start of the embedded node binary against the
# bundled server.mjs (no npm install, no node_modules - see
# server/scripts/bundle-for-embed.mjs), then poll for up to 10s (20 x
# 500ms) before giving up with a real error. Started via a `( cd ... )`
# subshell so the cd never affects the rest of this script; nohup alone
# (no explicit disown) is enough for the process to survive both this
# subshell's exit and the launcher's own eventual exit.
start_server_if_needed() {
  if is_server_healthy; then return 0; fi

  ensure_server_env_file

  local node_bin
  node_bin="$(resolve_node_binary)"
  if [ ! -x "$node_bin" ]; then
    show_error 'This MarketPane.app is missing its embedded Node.js runtime - it may not have downloaded completely.\n\nTry re-downloading MarketPane.app.'
    return 1
  fi

  (
    cd "$CONFIG_DIR" && \
    PORT="$PORT" \
    WEB_DIST_PATH="$WEB_DIST_DIR" \
    SERVER_DATA_DIR="$SERVER_DATA_DIR" \
    WEB_ORIGIN="http://localhost:$PORT" \
    nohup "$node_bin" "$SERVER_SCRIPT" >"$SERVER_LOG" 2>&1 &
  )

  local attempts=0
  while ! is_server_healthy && [ "$attempts" -lt 20 ]; do
    sleep 0.5
    attempts=$((attempts + 1))
  done

  if ! is_server_healthy; then
    local msg
    printf -v msg 'The server did not come up after 10 seconds.\n\nLog: %s' "$SERVER_LOG"
    show_error "$msg"
    return 1
  fi
  return 0
}

# --- browser detection -----------------------------------------------------

# mdfind (Spotlight) resolves an app bundle by identifier regardless of
# *where* it's installed (/Applications, ~/Applications, anywhere indexed) -
# the macOS analogue of the Windows launcher's "App Paths" registry lookup,
# which finds a browser "regardless of where it happens to be installed, not
# just the handful of default Program Files locations a fixed path list can
# guess" (same comment, same reasoning, different OS mechanism). Falls back
# to the conventional /Applications path if Spotlight indexing is off.
find_app_bundle() {
  local bundle_id="$1"
  local fallback_path="$2"
  local found
  found="$(mdfind "kMDItemCFBundleIdentifier == '$bundle_id'" 2>/dev/null | head -n 1)"
  if [ -n "$found" ] && [ -d "$found" ]; then
    printf '%s' "$found"
    return 0
  fi
  if [ -d "$fallback_path" ]; then
    printf '%s' "$fallback_path"
    return 0
  fi
  return 1
}

# Emits "Display Name|/path/to/Browser.app|is_chromium" per detected
# browser, one per line - display-preference order matches the Windows
# launcher's Get-InstalledBrowsers list.
detect_browsers() {
  local path
  path="$(find_app_bundle "com.google.Chrome" "/Applications/Google Chrome.app")" && printf 'Google Chrome|%s|1\n' "$path"
  path="$(find_app_bundle "com.microsoft.edgemac" "/Applications/Microsoft Edge.app")" && printf 'Microsoft Edge|%s|1\n' "$path"
  path="$(find_app_bundle "org.mozilla.firefox" "/Applications/Firefox.app")" && printf 'Mozilla Firefox|%s|0\n' "$path"
  path="$(find_app_bundle "com.brave.Browser" "/Applications/Brave Browser.app")" && printf 'Brave|%s|1\n' "$path"
  path="$(find_app_bundle "com.operasoftware.Opera" "/Applications/Opera.app")" && printf 'Opera|%s|1\n' "$path"
  # Opera GX is a genuinely separate app from regular Opera - its own
  # bundle identifier and its own install path, not a variant find_app_bundle
  # would ever match via the "com.operasoftware.Opera" lookup above. Missing
  # this meant a Mac with only Opera GX installed (no other supported
  # browser) hit detect_browsers' "no supported browser found" error path
  # even though a perfectly good Chromium-based browser was right there.
  path="$(find_app_bundle "com.operasoftware.OperaGX" "/Applications/Opera GX.app")" && printf 'Opera GX|%s|1\n' "$path"
  path="$(find_app_bundle "com.vivaldi.Vivaldi" "/Applications/Vivaldi.app")" && printf 'Vivaldi|%s|1\n' "$path"
  path="$(find_app_bundle "company.thebrowser.Browser" "/Applications/Arc.app")" && printf 'Arc|%s|1\n' "$path"
  return 0
}

save_browser_config() {
  local name="$1"
  local path="$2"
  local is_chromium="$3"
  mkdir -p "$CONFIG_DIR"
  {
    printf 'BROWSER_NAME=%q\n' "$name"
    printf 'BROWSER_PATH=%q\n' "$path"
    printf 'BROWSER_IS_CHROMIUM=%q\n' "$is_chromium"
  } >"$CONFIG_PATH"
}

load_browser_config() {
  BROWSER_NAME=""
  BROWSER_PATH=""
  BROWSER_IS_CHROMIUM="0"
  if [ -f "$CONFIG_PATH" ]; then
    # shellcheck disable=SC1090
    source "$CONFIG_PATH"
  fi
}

# Native "choose from list" picker - the AppleScript analogue of the
# Windows launcher's radio-button form. Returns 0 and writes config on a
# valid pick, 1 if the user cancelled or nothing was detected.
pick_browser() {
  local browsers_raw
  browsers_raw="$(detect_browsers)"

  if [ -z "$browsers_raw" ]; then
    show_error 'No supported browser (Chrome, Edge, Firefox, Brave, Opera, Opera GX, Vivaldi, or Arc) was found on this Mac.\n\nInstall one, then reopen MarketPane.'
    return 1
  fi

  local names=()
  while IFS='|' read -r name path is_chromium; do
    [ -z "$name" ] && continue
    names+=("$name")
  done <<<"$browsers_raw"

  # Skip the picker dialog entirely when there is only one real choice -
  # most Macs only have one browser installed, and an AppleScript "choose
  # from list" window (which looks nothing like a normal macOS dialog) is
  # an unfamiliar, slightly alarming extra step for a non-technical user
  # when it is not actually offering a real decision. Still confirms via a
  # plain info dialog so linking a browser is never silent.
  if [ "${#names[@]}" -eq 1 ]; then
    while IFS='|' read -r name path is_chromium; do
      [ -z "$name" ] && continue
      save_browser_config "$name" "$path" "$is_chromium"
      local msg
      printf -v msg 'Linked to %s - the only supported browser found on this Mac.\n\n(Want to use a different one instead? Install it, then quit and reopen MarketPane - "Change Linked Browser" will offer every one it finds.)' "$name"
      show_info "$msg"
      return 0
    done <<<"$browsers_raw"
  fi

  local applescript_items=""
  local n
  for n in "${names[@]}"; do
    applescript_items="${applescript_items}\"${n}\", "
  done
  applescript_items="{${applescript_items%, }}"

  local script
  script="$(mktemp /tmp/marketpane-picker.XXXXXX.applescript)"
  cat >"$script" <<EOF
set browserList to $applescript_items
set chosen to choose from list browserList with title "MarketPane" with prompt "MarketPane found more than one browser on this Mac. Pick the one it should open in - you can change this later from the MarketPane window's \"Change Linked Browser\" button." default items {item 1 of browserList}
if chosen is false then
	return "CANCELLED"
else
	return item 1 of chosen
end if
EOF
  local chosen
  chosen="$(run_applescript_file "$script")"
  rm -f "$script"

  if [ "$chosen" = "CANCELLED" ] || [ -z "$chosen" ]; then
    return 1
  fi

  while IFS='|' read -r name path is_chromium; do
    [ -z "$name" ] && continue
    if [ "$name" = "$chosen" ]; then
      save_browser_config "$name" "$path" "$is_chromium"
      return 0
    fi
  done <<<"$browsers_raw"

  return 1
}

# --- browser launch ----------------------------------------------------

# Chromium's "--app=<url>" flag opens a borderless window with no address
# bar, tabs, or bookmarks - same trick and same reasoning as the Windows
# launcher's Open-Browser: it is still the real, already-installed browser
# process (full internet access), just launched to look like a standalone
# app. Firefox has no equivalent flag and falls back to a normal window,
# exactly like the Windows version's Firefox special-case.
open_browser() {
  local url="$1"
  if [ -z "${BROWSER_PATH:-}" ] || [ ! -d "$BROWSER_PATH" ]; then
    show_error 'No browser is linked yet. Restart MarketPane to link one.'
    return 1
  fi

  if [ "${BROWSER_IS_CHROMIUM:-0}" = "1" ]; then
    local exe_name
    exe_name="$(/usr/libexec/PlistBuddy -c "Print :CFBundleExecutable" "$BROWSER_PATH/Contents/Info.plist" 2>/dev/null)"
    local binary="$BROWSER_PATH/Contents/MacOS/$exe_name"
    if [ -n "$exe_name" ] && [ -x "$binary" ]; then
      (nohup "$binary" "--app=$url" >/dev/null 2>&1 &)
      return 0
    fi
  fi

  # Non-Chromium (Firefox), or the app-mode binary could not be resolved -
  # `open -a` still launches the real linked browser, just in a normal window.
  if ! open -a "$BROWSER_PATH" "$url" 2>/dev/null; then
    local msg
    printf -v msg 'Could not launch the linked browser at:\n%s' "$BROWSER_PATH"
    show_error "$msg"
    return 1
  fi
  return 0
}

# --- status window (AppleScript dialog loop) -------------------------------

# A persistent WinForms status window with live-updating text has no
# Xcode-free equivalent on macOS (osacompile, the AppleScript app compiler,
# only runs ON macOS - it cannot be invoked from this authoring machine to
# produce a real .app). This loop is the closest native approximation: each
# iteration is a fresh, native `display dialog` showing current status with
# the same actions (Open in Browser / Change Linked Browser / Quit) as the
# Windows window's buttons.
show_status_and_wait() {
  local script
  local button
  local message
  while true; do
    printf -v message 'Linked browser: %s\n\nRunning: localhost:%s' "$BROWSER_NAME" "$PORT"
    script="$(mktemp /tmp/marketpane-status.XXXXXX.applescript)"
    cat >"$script" <<EOF
display dialog "$message" with title "MarketPane" buttons {"Change Linked Browser", "Quit", "Open in Browser"} default button "Open in Browser"
EOF
    button="$(run_applescript_file "$script")"
    rm -f "$script"

    case "$button" in
    button\ returned:Open\ in\ Browser)
      open_browser "$SIMULATOR_URL"
      ;;
    button\ returned:Change\ Linked\ Browser)
      if pick_browser; then
        load_browser_config
      fi
      ;;
    *)
      return 0
      ;;
    esac
  done
}

main() {
  load_browser_config

  local is_first_run=0
  [ ! -f "$CONFIG_PATH" ] && is_first_run=1

  if [ -z "$BROWSER_PATH" ] || [ ! -d "$BROWSER_PATH" ]; then
    if ! pick_browser; then
      exit 0
    fi
    load_browser_config
  fi

  if ! start_server_if_needed; then
    exit 1
  fi

  open_browser "$SIMULATOR_URL"

  if [ "$is_first_run" = "1" ]; then
    show_info 'MarketPane is ready - Decision Replay, the Simulator, Tax Understanding, the Sandbox, and Learn are all running in the window that just opened.\n\nOptional: for the AI-powered explain/translate features, add a real Gemini API key to ~/Library/Application Support/MarketPane/.env - the placeholder key lets everything else run fine without one.'
  fi

  show_status_and_wait
}

main
