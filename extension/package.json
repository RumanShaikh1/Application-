{
  "name": "marketpane-extension",
  "version": "1.0.0",
  "description": "MarketPane browser extension - injects the Jargon Buster sidebar into any page you browse",
  "private": true,
  "scripts": {
    "build": "vite build --config vite.config.content.ts && vite build --config vite.config.background.ts",
    "watch": "concurrently -k \"vite build --config vite.config.content.ts --watch\" \"vite build --config vite.config.background.ts --watch\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.21",
    "puppeteer": "^25.3.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
